{
  "manifest_version": 3,
  "name": "TikCare",
  "version": "0.1.0",
  "description": "Parent-controlled, deny-by-default TikTok environment.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://tiktok.com/*"
      ],
      "js": ["content.js"],
      "css": ["foundation.css", "child.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikCare"
  }
}
